# Copy to .env.deploy and fill in. .env.deploy is gitignored.
# Everything here is infrastructure identifiers, not secrets - AWS
# credentials come from your named profile / normal AWS credential chain.

AWS_PROFILE_NAME=your-aws-profile
SITE_DOMAIN=example.com
S3_BUCKET=your-site-bucket
CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC

# Only needed by scripts/stats.sh (access-log analysis)
AWS_ACCOUNT_ID=123456789012
LOGS_BUCKET=your-logs-bucket

# Only needed once, by scripts/attach-domain.sh
ACM_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx

# Second site: the league-wide platform. The deploy scripts read the plain
# SITE_DOMAIN/S3_BUCKET/CLOUDFRONT_DISTRIBUTION_ID names, so target this one by
# exporting those from these values (see docs/INFRASTRUCTURE.md).
NHL_SITE_DOMAIN=nhl.example.com
NHL_S3_BUCKET=your-nhl-bucket
NHL_CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC
NHL_DISTRIBUTION_DOMAIN=dxxxxxxxxxxxxx.cloudfront.net
NHL_ORIGIN_ACCESS_CONTROL_ID=E1234567890ABC
